    {
      "type": "timeseries",
      "title": "FlexD pool load (vLLM pod metrics)",
      "description": "Live load on flexd pods, regardless of routing path. Source: vllm:num_requests_{running,waiting} and vllm:kv_cache_usage_perc filtered by pod=~\"vllm-flexd-.*\". This panel rises whenever ANY traffic lands on a flexd pod -- including normal decode-filter routing where flexd is a candidate. To check whether the load is actually driven by SLO-aware activation, cross-reference with the FlexD activation bars on the TTFT/TPOT panels above: if those bars are flat at 0 while these series move, flexd is being used as a regular decoder, not as a temporary prefiller.",
      "id": 24,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 42
